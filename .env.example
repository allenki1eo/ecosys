# --- Database (Turso / libSQL) ---------------------------------------------
# For local dev leave these unset and a local SQLite file (./local.db) is used.
TURSO_DATABASE_URL="libsql://ecohygiene-<org>.turso.io"
TURSO_AUTH_TOKEN=""
# Optional: embedded replica path for low-latency reads from Shinyanga.
# TURSO_SYNC_URL="libsql://ecohygiene-<org>.turso.io"
# TURSO_REPLICA_PATH="file:./replica.db"

# --- Auth -------------------------------------------------------------------
# Used to sign/verify nothing by itself (sessions are DB-backed) but required
# for cookie hardening in production. Generate: openssl rand -base64 32
AUTH_SECRET=""

# --- File storage (job photos, signatures, certificate PDFs) ----------------
# Cloudflare R2 (S3-compatible) or Supabase Storage.
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ecohygiene-media"
R2_PUBLIC_BASE_URL=""

# --- Notifications ----------------------------------------------------------
# Africa's Talking SMS (job reminders to crew + client contacts)
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID="ECOHYGIENE"
NOTIFICATIONS_ENABLED="false"
